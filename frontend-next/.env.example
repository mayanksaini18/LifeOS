# Copy to .env.local and fill in. Every var here is NEXT_PUBLIC_*, meaning it is
# inlined into the client bundle and visible to anyone using the site — none of
# these are secrets. Firebase web API keys are identifiers, not credentials;
# access is controlled by Firebase Auth settings and backend token verification.

# --- Backend API ---
# Defaults to the deployed Render backend when unset, so a local frontend talks
# to PRODUCTION data. Point it at your local backend while developing.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# --- Firebase (Google sign-in only) ---
# Optional. With these unset, the app runs fine and the "Continue with Google"
# button hides itself; email and password sign-in is unaffected. Set them to
# enable Google sign-in. Values come from the Firebase console under
# Project settings → Your apps → SDK setup and configuration, or from
# `vercel env pull .env.local` if the project is linked.
#
# NEXT_PUBLIC_FIREBASE_PROJECT_ID must equal the backend's FIREBASE_PROJECT_ID
# (currently lifeos-f9dc4), or the backend rejects every Google token with a 401.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lifeos-f9dc4.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lifeos-f9dc4
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
